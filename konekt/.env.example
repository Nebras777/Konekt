# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys. Get the actual values from
# whoever's sharing them for this project (Slack/Discord), not from git.

# Required for AI-generated day summaries. Get one at console.anthropic.com.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Optional — without it, photos fall back to a stable placeholder image.
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=
